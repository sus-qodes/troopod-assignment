{%- comment -%}
  Purelane — Customer Reviews Auto Marquee Section
  Auto-scrolling review card carousel with aggregate rating header and pause-on-hover.
{%- endcomment -%}

{%- style -%}
  .revband {
    padding: var(--sec-y) 0;
  }
  .revhead {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px 18px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .revhead .agg {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--paper-2);
  }
  .revhead .agg b {
    font-family: 'Outfit', sans-serif;
    font-size: 16px;
    color: var(--accent);
    letter-spacing: 0;
  }
  .revhead .st {
    color: #7a9c1e;
    font-size: 12px;
    letter-spacing: .16em;
  }
  .revrail {
    overflow: hidden;
    position: relative;
    -webkit-mask-image: linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
    mask-image: linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
  }
  .revtrack {
    display: flex;
    gap: 12px;
    width: max-content;
    animation: marq {{ section.settings.speed | default: 52 }}s linear infinite;
  }
  .revrail:hover .revtrack, .revrail:focus-within .revtrack {
    animation-play-state: paused;
  }
  @keyframes marq {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(-50%,0,0); }
  }
  .rcard {
    flex: 0 0 auto;
    width: 284px;
    padding: 15px 17px;
    border-radius: 18px;
  }
  .rcard .st {
    color: #7a9c1e;
    font-size: 10.5px;
    letter-spacing: .2em;
    margin-bottom: 9px;
  }
  .rcard h5 {
    font-family: 'Outfit', sans-serif;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    color: var(--surface);
    margin-bottom: 7px;
  }
  .rcard p {
    font-size: 12.6px;
    color: var(--paper-2);
    line-height: 1.52;
    margin-bottom: 11px;
  }
  .rcard .who {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  .rcard .who b {
    color: #01423b;
    font-weight: 700;
  }
  .rcard .who svg {
    width: 12px;
    height: 12px;
    color: #4f7d10;
    flex: 0 0 auto;
  }
  @media(max-width:760px) {
    .rcard { width: 250px; }
    .revtrack { animation-duration: 40s; }
  }
{%- endstyle -%}

<section class="sec revband" id="reviews" data-scene="1" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">{{ section.settings.stars | default: "★★★★★" }}</span> <b>{{ section.settings.rating_score | default: "4.8" }}</b> {{ section.settings.rating_text | default: "from 8,000+ reviews" }}</span>
      <span class="agg">{{ section.settings.social_proof_prefix | default: "Loved by" }} <b>{{ section.settings.social_proof_highlight | default: "12 lakh+" }}</b> {{ section.settings.social_proof_suffix | default: "homes" }}</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {%- if section.blocks.size > 0 -%}
        {%- comment -%} Render review blocks twice for seamless marquee loop {%- endcomment -%}
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            <article class="glass-2 rcard" {{ block.shopify_attributes }}>
              <div class="st">{{ block.settings.stars | default: "★★★★★" }}</div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.body }}</p>
              <div class="who">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
                <b>{{ block.settings.author }}</b>
                <span>&middot; {{ block.settings.product_category }}</span>
              </div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default fallback review cards {%- endcomment -%}
        {%- for i in (1..2) -%}
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h5>Works like a charm</h5>
            <p>Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Anita</b><span>&middot; Laundry detergent</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h5>Best dishwash ever</h5>
            <p>Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Priya</b><span>&middot; Dishwash gel</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h5>Great product, great packaging</h5>
            <p>Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Sunita</b><span>&middot; Liquid handwash</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h5>Dog friendly</h5>
            <p>We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Rohit S.</b><span>&middot; Floor cleaner</span></div>
          </article>
          <article class="glass-2 rcard">
            <div class="st">★★★★★</div>
            <h5>Sparkling taps again</h5>
            <p>Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.</p>
            <div class="who"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg><b>Verified buyer</b><span>&middot; Tap cleaner</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>


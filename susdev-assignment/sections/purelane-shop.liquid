{%- comment -%}
  Purelane — Shop / Product Grid & Categories Showcase
  Exact verbatim 1-to-1 copy from purelane-homepage.html lines 1247–1475.
{%- endcomment -%}

{%- style -%}
  /* ---------- SHELF ---------- */
  .shelf{display:grid;gap:14px;grid-template-columns:repeat(2,1fr)}
  @media(min-width:860px){.shelf{grid-template-columns:repeat(4,1fr)}}
  .card{padding:16px;display:flex;flex-direction:column;transition:.4s var(--ease)}
  .card:hover{transform:translateY(-5px)}
  .card .shot{height:150px;border-radius:14px;margin-bottom:14px;display:grid;place-items:center;position:relative;overflow:hidden;
    background:linear-gradient(160deg,rgba(236,230,247,.12),rgba(75,58,143,.2));border:1px solid rgba(236,230,247,.14)}
  .card .shot svg{height:122px;width:auto}
  .card .pill{position:absolute;top:9px;left:9px;font-size:8.5px;font-weight:800;letter-spacing:.13em;text-transform:uppercase;
    padding:4px 9px;border-radius:999px;background:rgba(255,255,255,.86);border:1px solid rgba(75,58,143,.22);color:#00706a}
  .card h4{font-family:'Outfit',sans-serif;font-size:13.5px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--surface);line-height:1.2;margin-bottom:7px}
  .card .rate{font-size:11.5px;color:var(--paper-2);margin-bottom:10px;display:flex;align-items:center;gap:5px}
  .card .rate b{color:var(--accent);font-weight:700}
  .card .pr{margin-top:auto;display:flex;align-items:baseline;gap:8px;margin-bottom:12px}
  .card .pr strong{font-family:'Outfit',sans-serif;font-size:18px;color:var(--surface);font-weight:700}
  .card .pr s{font-size:12px;color:var(--paper-3)}
  .card .pr em{font-style:normal;font-size:10px;font-weight:800;letter-spacing:.08em;color:var(--accent)}
  .card .btn{width:100%;justify-content:center}

  /* ---------- FULL RANGE SHELF ---------- */
  .range{padding:26px 20px 22px}
  .range-head{display:flex;flex-direction:column;gap:12px;margin-bottom:20px}
  @media(min-width:760px){.range-head{flex-direction:row;align-items:flex-end;justify-content:space-between}}
  .stripwrap{overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch;margin:0 -20px;padding:0 20px 10px}
  .stripwrap::-webkit-scrollbar{display:none}
  .rangerow{display:flex;align-items:flex-end;gap:14px;width:max-content}
  .rangerow .pimg{height:120px;filter:drop-shadow(0 6px 10px rgba(0,74,66,.12))}
  .striphint{text-align:center;font-size:11px;color:var(--paper-3);margin-top:10px}

  /* ---------- WHY BUNDLES BEAT BUYING SINGLE ---------- */
  .wb{display:grid;gap:20px 16px;grid-template-columns:repeat(2,1fr)}
  @media(min-width:880px){.wb{grid-template-columns:repeat(4,1fr)}}
  .wb-i{text-align:center}
  .wb-i .ci{width:58px;height:58px;margin:0 auto 16px;border-radius:50%;display:grid;place-items:center;
    background:radial-gradient(circle at 36% 28%,rgba(255,255,255,.9),rgba(230,238,244,.5));
    border:1px solid rgba(180,200,190,.5);color:#477d10 !important}
  .wb-i .ci svg{width:24px;height:24px}
  .wb-i h4{font-family:'Outfit',sans-serif;font-size:13.5px;font-weight:800;text-transform:uppercase;letter-spacing:.04em;color:#1e1435;margin-bottom:6px}
  .wb-i p{font-size:12px;color:#475467;line-height:1.45;margin:0}

  /* ---------- BUNDLE CATEGORIES ---------- */
  .cats{display:grid;gap:14px;grid-template-columns:repeat(2,1fr)}
  @media(min-width:900px){.cats{grid-template-columns:repeat(4,1fr)}}
  .cat{padding:0;display:flex;flex-direction:column;transition:.4s var(--ease)}
  .cat:hover{transform:translateY(-5px)}
  .cat .ph{height:194px;display:flex;align-items:flex-end;justify-content:center;padding:14px 12px 0;position:relative}
  .cat .ph::before{content:"";position:absolute;inset:0;
    background:radial-gradient(110% 80% at 50% 6%,rgba(236,230,247,.20),rgba(75,58,143,.10) 56%,transparent 78%)}
  .cat .ph .pimg{position:relative;height:176px;filter:drop-shadow(0 16px 24px rgba(1,24,22,.58))}
  .cat .txt{padding:14px 16px 18px;border-top:1px solid rgba(236,230,247,.12)}
  .cat .txt h4{font-family:'Outfit',sans-serif;font-size:14px;font-weight:700;text-transform:uppercase;letter-spacing:.03em;color:var(--surface);margin-bottom:5px}
  .cat .txt p{font-size:11.8px;color:var(--paper-3)}
{%- endstyle -%}

<!-- ================= SHOP ================= -->
<section class="sec" id="shop" data-scene="3" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker | default: "Bestsellers" }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: "Loved by 30,000 homes" }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    
    <div class="shelf">
      {%- assign shop_collection = section.settings.collection -%}
      {%- if shop_collection != blank and shop_collection.products.size > 0 -%}
        {%- for product in shop_collection.products limit: 8 -%}
          <article class="glass card rv">
            <div class="shot">
              {%- if product.compare_at_price > product.price -%}
                <span class="pill">Sale</span>
              {%- else -%}
                <span class="pill">Best seller</span>
              {%- endif -%}

              {%- if product.featured_image != blank -%}
                <img class="custom-shop-img" src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title | escape }}" width="148" height="148">
              {%- else -%}
                <span class="pimg p-kitchen" role="img"></span>
              {%- endif -%}
            </div>
            <h4>{{ product.title }}</h4>
            <div class="rate"><b>★ 4.8</b> · Verified</div>
            <div class="pr">
              <strong>{{ product.price | money }}</strong>
              {%- if product.compare_at_price > product.price -%}
                <s>{{ product.compare_at_price | money }}</s>
                {%- assign off_diff = product.compare_at_price | minus: product.price -%}
                {%- assign off_pct = off_diff | times: 100 | divided_by: product.compare_at_price -%}
                <em>{{ off_pct }}% off</em>
              {%- endif -%}
            </div>
            
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ product.first_available_variant.id }}">
              <button type="submit" class="btn btn-ghost btn-sm">Add to cart</button>
            </form>
          </article>
        {%- endfor -%}
      {%- else -%}

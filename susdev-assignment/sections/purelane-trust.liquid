{%- comment -%}
  Purelane — Trust Bar Section
  Exact 1-to-1 verbatim copy from purelane-homepage.html lines 1478–1499.
{%- endcomment -%}

{%- style -%}
  /* ---------- TRUST BAR (VERBATIM FROM PROTOTYPE) ---------- */
  .trust{display:grid;grid-template-columns:repeat(2,1fr);gap:2px;padding:6px}
  @media(min-width:820px){.trust{grid-template-columns:repeat(4,1fr)}}
  .trust-i{display:flex;align-items:center;gap:12px;padding:16px 14px}
  .trust-i svg{width:26px;height:26px;color:#00706a !important;flex:0 0 auto}
  .trust-i span{font-family:'Outfit',sans-serif;font-size:11px;font-weight:700;letter-spacing:.11em;text-transform:uppercase;color:var(--paper-2);line-height:1.32}
{%- endstyle -%}

<!-- ================= TRUST BAR ================= -->
<section class="sec" data-scene="4" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass trust rv">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="trust-i" {{ block.shopify_attributes }}>
            {%- if block.settings.svg != blank -%}
              {{ block.settings.svg }}
            {%- elsif forloop.index == 2 -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
            {%- elsif forloop.index == 3 -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
            {%- elsif forloop.index == 4 -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
            {%- else -%}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
            {%- endif -%}
            <span>{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          <span>Plant derived<br>formulas</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h16v11a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Z"/><path d="M4 8 6.5 3h11L20 8M9.5 12h5"/></svg>
          <span>Recyclable<br>packaging</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
          <span>Safe for<br>kids &amp; pets</span>
        </div>
        <div class="trust-i">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2M12 3.4c2.4 2.4 3.6 5.4 3.6 8.6S14.4 18.2 12 20.6c-2.4-2.4-3.6-5.4-3.6-8.6S9.6 5.8 12 3.4Z"/></svg>
          <span>Made in<br>India</span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "class": "section-purelane-trust",
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "html",
          "id": "svg",
          "label": "SVG Icon HTML"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Trust Item Text",
          "default": "Plant derived formulas"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Bar",
      "blocks": [
        {
          "type": "trust_item",
          "settings": { "text": "Plant derived<br>formulas" }
        },
        {
          "type": "trust_item",
          "settings": { "text": "Recyclable<br>packaging" }
        },
        {
          "type": "trust_item",
          "settings": { "text": "Safe for<br>kids & pets" }
        },
        {
          "type": "trust_item",
          "settings": { "text": "Made in<br>India" }
        }
      ]
    }
  ]
}
{% endschema %}

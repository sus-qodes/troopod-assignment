{%- comment -%}
  Purelane — Navigation Header Section
  Glassmorphic pill nav bar with brand mark, navigation links, and tool icons.
{%- endcomment -%}

{%- style -%}
  header.purelane-header {
    position: fixed;
    top: 38px;
    left: 0;
    right: 0;
    z-index: 50;
    padding: 0 14px;
    transition: top .4s var(--ease);
  }
  header.purelane-header.up {
    top: 10px;
  }
  .navpill {
    max-width: var(--maxw);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 10px 14px;
    border-radius: 999px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 11px;
    flex: 0 0 auto;
  }
  .brand .mark {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    background: linear-gradient(150deg,rgba(201,118,29,.20),rgba(75,58,143,.14));
    border: 1px solid rgba(75,58,143,.18);
  }
  .brand .mark svg {
    width: 23px;
    height: 23px;
    color: #b8701c !important;
  }
  .brand .txt {
    line-height: 1.05;
  }
  .brand .n1 {
    display: block;
    font-family: 'Outfit', sans-serif;
    font-weight: 800;
    font-size: 16.5px;
    line-height: 1.06;
    letter-spacing: .02em;
    text-transform: uppercase;
    color: var(--surface);
  }
  .brand .n2 {
    display: block;
    font-size: 8.5px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: .28em;
    text-transform: uppercase;
    color: var(--paper-3);
  }
  .nav {
    display: none;
    gap: 26px;
    margin: 0 auto;
    font-size: 13.5px;
    font-weight: 500;
  }
  .nav a {
    color: var(--paper-2);
    padding: 6px 0;
    position: relative;
    transition: .3s;
  }
  .nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 0;
    height: 1.5px;
    background: #b8701c;
    transition: right .35s var(--ease);
  }
  .nav a:hover {
    color: var(--surface);
  }
  .nav a:hover::after {
    right: 0;
  }
  .navtools {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  .ico {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    color: var(--paper-2);
    transition: .3s;
    position: relative;
  }
  .ico:hover {
    background: rgba(75,58,143,.09);
    color: var(--surface);
  }
  .ico svg {
    width: 18px;
    height: 18px;
  }
  .dot {
    position: absolute;
    top: 5px;
    right: 5px;
    min-width: 16px;
    height: 16px;
    border-radius: 999px;
    background: #4b3a8f;
    color: #f4fdf6;
    font-size: 9.5px;
    font-weight: 800;
    display: grid;
    place-items: center;
    padding: 0 4px;
  }
  .burger {
    display: grid;
  }
  .purelane-mobile-drawer {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    left: 14px;
    right: 14px;
    background: rgba(255,255,255,.94);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(75,58,143,.16);
    border-radius: 20px;
    padding: 20px;
    box-shadow: 0 18px 44px rgba(58,44,112,.18);
    z-index: 100;
  }
  .purelane-mobile-drawer.open {
    display: block;
  }
  .purelane-mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--surface);
  }
  .purelane-mobile-nav a {
    padding: 8px 0;
    border-bottom: 1px solid rgba(75,58,143,.08);
  }
  .purelane-mobile-tools {
    display: flex;
    gap: 10px;
    margin-top: 8px;
    padding-top: 8px;
  }
  @media(max-width:600px) {
    .ico.hide-s { display: none; }
    .brand .mark { width: 34px; height: 34px; }
    .brand .n1 { font-size: 14.5px; }
    .brand .n2 { font-size: 7.6px; letter-spacing: .2em; }
    .navpill { gap: 10px; padding: 8px 10px; }
  }
  @media(min-width:1024px) {
    .nav { display: flex; }
    .burger { display: none; }
  }
{%- endstyle -%}

<header id="hdr" class="purelane-header" {{ section.shopify_attributes }}>
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          <path d="M12 21v-6"/>
        </svg>
      </span>
      <span class="txt">
        <span class="n1">{{ section.settings.brand_name | default: shop.name }}</span>
        <span class="n2">{{ section.settings.tagline | default: "Clean, simply" }}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main navigation">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
    </nav>

    <div class="navtools">
      <a href="{{ routes.search_url }}" class="ico hide-s" aria-label="Search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="ico hide-s" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="8" r="3.6"/><path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/></svg>
      </a>
      <a href="{{ routes.cart_url }}" class="ico cart-icon-bubble" id="cart-icon-bubble" aria-label="Cart, {{ cart.item_count }} items">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/><circle cx="10" cy="20.5" r="1.1"/><circle cx="17.5" cy="20.5" r="1.1"/></svg>
        <span class="dot">{{ cart.item_count }}</span>
      </a>
      <button class="ico burger" id="purelane-burger-btn" aria-label="Menu" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8h16M4 16h16"/></svg>
      </button>
    </div>
  </div>

  <div class="purelane-mobile-drawer" id="purelane-mobile-drawer" aria-hidden="true">
    <nav class="purelane-mobile-nav">
      {%- if section.settings.menu != blank -%}
        {%- for link in section.settings.menu.links -%}
          <a href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      {%- else -%}
        <a href="#top">Home</a>
        <a href="#ingredients">Ingredients</a>
        <a href="#how">How it works</a>
        <a href="#shop">Shop</a>
        <a href="#bundles">Bundles</a>
      {%- endif -%}
      <div class="purelane-mobile-tools">
        <a href="{{ routes.search_url }}" class="btn btn-ghost btn-sm">Search</a>
        <a href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" class="btn btn-ghost btn-sm">Account</a>
      </div>
    </nav>
  </div>
</header>

<script>
  (function() {
    var hdr = document.getElementById('hdr');
    var burger = document.getElementById('purelane-burger-btn');
    var drawer = document.getElementById('purelane-mobile-drawer');

    function onScroll() {
      var y = window.scrollY || window.pageYOffset;
      if (hdr) hdr.classList.toggle('up', y > 90);
    }
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    if (burger && drawer) {
      burger.addEventListener('click', function() {
        var isOpen = drawer.classList.toggle('open');
        burger.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
        drawer.setAttribute('aria-hidden', isOpen ? 'false' : 'true');
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Purelane Header",
  "tag": "section",
  "class": "section-purelane-header",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "Brand Name",
      "default": "Purelane"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Subtitle",
      "default": "Clean, simply"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation Menu",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Purelane Header"
    }
  ]
}
{% endschema %}

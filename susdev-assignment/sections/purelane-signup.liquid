{%- comment -%}
  Purelane — Newsletter / Club Signup Section
  Includes email input form, incentive title, and discount kicker.
{%- endcomment -%}

{%- style -%}
  .signup{padding:34px 20px 36px;text-align:center;max-width:680px;margin:0 auto}
  .signup form{display:flex;gap:10px;max-width:440px;margin:22px auto 0;flex-direction:column}
  @media(min-width:540px){.signup form{flex-direction:row}}
  .signup input[type="email"]{flex:1;padding:12px 16px;border-radius:999px;border:1px solid rgba(75,58,143,.24);
    background:rgba(255,255,255,.9);color:var(--surface);font-size:13px;outline:none;transition:all .3s var(--ease)}
  .signup input[type="email"]:focus{border-color:#00706a;box-shadow:0 0 0 3px rgba(0,112,106,.15)}
  .signup .btn{justify-content:center}
{%- endstyle -%}

<section class="sec" id="signup" data-scene="4" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass signup rv">
      <span class="kicker">{{ section.settings.kicker | default: "Join the Purelane Club" }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: "Get ₹100 off your first bundle" }}</h2>
      <p class="lede" style="margin:0 auto">{{ section.settings.description | default: "Plus first access to new launches and restocks." }}</p>
      
      {%- form 'customer', class: 'signup-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder | default: "your@email.com" }}" aria-label="Email address" required>
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label | default: "Get my ₹100 off" }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Club Signup Box",
  "tag": "section",
  "class": "section-purelane-signup",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Join the Purelane Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get ₹100 off your first bundle"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Plus first access to new launches and restocks."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email Input Placeholder",
      "default": "your@email.com"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit Button Label",
      "default": "Get my ₹100 off"
    }
  ],
  "presets": [
    {
      "name": "Club Signup Box"
    }
  ]
}
{% endschema %}

{%- comment -%}
  Purelane — Why It Works / Pillars Section
  Combines the 3-pillar feature cards, proof panel with 6-product animated rotator, and 4 stat rings.
  Supports custom uploaded image, Shopify product featured image, or SVG fallback artwork in the rotator.
{%- endcomment -%}

{%- style -%}
  .rot{position:relative;padding:18px 12px 16px;border-radius:22px;display:flex;flex-direction:column;align-items:center;justify-content:center}
  .rot .frame{position:relative;width:100%;height:206px}
  .rot .frame .pimg{position:absolute;left:50%;top:50%;height:196px;opacity:0;
    transform:translate(-50%,-42%) scale(.94);
    transition:opacity .75s var(--ease),transform .75s var(--ease);
    filter:drop-shadow(0 11px 17px rgba(0,74,66,.14))}
  .rot .frame .pimg.custom-rot-img{width:auto;object-fit:contain}
  .rot .frame .pimg.on{opacity:1;transform:translate(-50%,-50%) scale(1)}
  .rot .cap{margin-top:12px;text-align:center;min-height:32px}
  .rot .cap b{display:block;font-family:'Outfit',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--surface)}
  .rot .cap span{display:block;font-size:11px;color:var(--paper-3);margin-top:3px}
  .rot .dots{display:flex;gap:6px;justify-content:center;margin-top:12px}
  .rot .dots i{width:5px;height:5px;border-radius:50%;background:rgba(75,58,143,.22);transition:.4s var(--ease)}
  .rot .dots i.on{background:#b8701c;width:17px;border-radius:999px}

  .proof{display:grid;gap:22px;grid-template-columns:1fr}
  @media(min-width:900px){.proof{grid-template-columns:1.05fr .62fr;gap:30px;align-items:center}}
  .proof-stats{margin-top:20px}

  @media(max-width:760px){
    .rot .frame{height:172px}
    .rot .frame .pimg{height:164px}
  }
{%- endstyle -%}

<!-- ================= PILLARS ================= -->
<section class="sec" id="how" data-scene="2" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="pillars">
      {%- assign pillar_blocks = section.blocks | where: "type", "pillar" -%}
      {%- if pillar_blocks.size > 0 -%}
        {%- for block in pillar_blocks -%}
          <article class="glass pillar rv {% cycle '', 'rv-d2', 'rv-d3' %}" {{ block.shopify_attributes }}>
            <span class="pi">
              {%- if block.settings.svg_icon != blank -%}
                {{ block.settings.svg_icon }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
              {%- endif -%}
            </span>
            <h3 class="d3">{{ block.settings.title }}</h3>
            <p class="body-s">{{ block.settings.description }}</p>
            <a class="btn btn-ghost btn-sm" href="{{ block.settings.link | default: "#shop" }}">{{ block.settings.link_text | default: "Learn more" }}</a>
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Default 3 pillars fallback {%- endcomment -%}
        <article class="glass pillar rv">
          <span class="pi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8.5" r="3.2"/><circle cx="16.4" cy="6.6" r="2.2"/><circle cx="15" cy="13" r="2.8"/><circle cx="8.6" cy="15.6" r="2.1"/><path d="M4 21h16"/></svg>
          </span>
          <h3 class="d3">Less scrubbing</h3>
          <p class="body-s">A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.</p>
          <a class="btn btn-ghost btn-sm" href="#shop">Learn more</a>
        </article>
        <article class="glass pillar rv rv-d2">
          <span class="pi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          </span>
          <h3 class="d3">Clean ingredients</h3>
          <p class="body-s">No sulphates, no chlorine, no synthetic fragrance. Nothing on the label you would not want near your food.</p>
          <a class="btn btn-ghost btn-sm" href="#ingredients">Learn more</a>
        </article>
        <article class="glass pillar rv rv-d3">
          <span class="pi">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.4A4.1 4.1 0 0 1 12 8a4.1 4.1 0 0 1 7 2.6c0 5-7 9.4-7 9.4Z"/></svg>
          </span>
          <h3 class="d3">Safe around everyone</h3>
          <p class="body-s">Gentle on hands, safe around kids and pets, and it leaves no toxic residue on the surfaces you touch every day.</p>
          <a class="btn btn-ghost btn-sm" href="#proof">Learn more</a>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

<!-- ================= PROOF ================= -->
<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker | default: "Why it works" }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: "Tough on grime. Gentle on everything else." }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.description | default: "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for." }}</p>
          <a class="btn btn-primary" href="{{ section.settings.btn_link | default: "#ingredients" }}">{{ section.settings.btn_label | default: "See the ingredient list" }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </div>

        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            {%- assign rot_blocks = section.blocks | where: "type", "rotator_item" -%}
            {%- if rot_blocks.size > 0 -%}
              {%- for block in rot_blocks -%}
                {%- assign rot_title = block.settings.title -%}
                {%- if rot_title == blank and block.settings.product != blank -%}
                  {%- assign rot_title = block.settings.product.title -%}
                {%- endif -%}
                {%- if rot_title == blank -%}
                  {%- assign rot_title = "Kitchen cleaner" -%}
                {%- endif -%}

                {%- assign rot_img = block.settings.image -%}
                {%- if rot_img == blank and block.settings.product != blank -%}
                  {%- assign rot_img = block.settings.product.featured_image -%}
                {%- endif -%}

                {%- if rot_img != blank -%}
                  <img class="pimg custom-rot-img{% if forloop.first %} on{% endif %}" src="{{ rot_img | image_url: width: 400 }}" alt="{{ rot_title | escape }}" data-name="{{ rot_title | escape }}" data-note="{{ block.settings.subtitle | escape }}" width="196" height="196" {{ block.shopify_attributes }}>
                {%- else -%}
                  <span class="pimg {{ block.settings.product_class | default: 'p-kitchen' }}{% if forloop.first %} on{% endif %}" role="img" aria-label="{{ rot_title | escape }}" data-name="{{ rot_title | escape }}" data-note="{{ block.settings.subtitle | escape }}" {{ block.shopify_attributes }}></span>
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <span class="pimg p-kitchen on" role="img" aria-label="Purelane foaming kitchen cleaner" data-name="Kitchen cleaner" data-note="Foam lifts grease, no scrubbing"></span>
              <span class="pimg p-tap" role="img" aria-label="Purelane tap cleaner and limescale remover" data-name="Tap &amp; limescale" data-note="Melts hard water stains"></span>
              <span class="pimg p-laundry" role="img" aria-label="Purelane non-toxic laundry detergent" data-name="Laundry detergent" data-note="Tough on odour, soft on fabric"></span>
              <span class="pimg p-toilet" role="img" aria-label="Purelane non-toxic toilet cleaner" data-name="Toilet cleaner" data-note="Kills 99.9% of germs"></span>
              <span class="pimg p-floor" role="img" aria-label="Purelane natural herbal floor cleaner" data-name="Floor cleaner" data-note="Neem powered, pet safe"></span>
              <span class="pimg p-dish" role="img" aria-label="Purelane organic dishwash liquid gel" data-name="Dishwash gel" data-note="Cuts grease, kind to hands"></span>
            {%- endif -%}
          </div>
          <div class="cap">
            {%- if rot_blocks.size > 0 -%}
              {%- assign first_rot = rot_blocks | first -%}
              {%- assign first_title = first_rot.settings.title -%}
              {%- if first_title == blank and first_rot.settings.product != blank -%}
                {%- assign first_title = first_rot.settings.product.title -%}
              {%- endif -%}
              <b>{{ first_title | default: "Kitchen cleaner" }}</b>
              <span>{{ first_rot.settings.subtitle | default: "Foam lifts grease, no scrubbing" }}</span>
            {%- else -%}
              <b>Kitchen cleaner</b><span>Foam lifts grease, no scrubbing</span>
            {%- endif -%}
          </div>
          <div class="dots">
            {%- if rot_blocks.size > 0 -%}
              {%- for block in rot_blocks -%}
                <i{% if forloop.first %} class="on"{% endif %}></i>
              {%- endfor -%}
            {%- else -%}
              <i class="on"></i><i></i><i></i><i></i><i></i><i></i>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
        {%- assign stat_blocks = section.blocks | where: "type", "stat" -%}
        {%- if stat_blocks.size > 0 -%}
          {%- for block in stat_blocks -%}
            <div class="stat" {{ block.shopify_attributes }}>
              <div class="ring">{{ block.settings.value }}</div>
              <h5>{{ block.settings.title }}</h5>
              <p>{{ block.settings.description }}</p>
            </div>
          {%- endfor -%}
        {%- else -%}
          <div class="stat">
            <div class="ring">99.9%</div>
            <h5>Germ kill</h5>
            <p>Tested against germs and bacteria</p>
          </div>
          <div class="stat">
            <div class="ring">0%</div>
            <h5>Sulphates</h5>
            <p>No SLS, chlorine or parabens</p>
          </div>
          <div class="stat">
            <div class="ring">100%</div>
            <h5>Plant based</h5>
            <p>Cleansers derived from plants</p>
          </div>
          <div class="stat">
            <div class="ring">4.8</div>
            <h5>Rated</h5>
            <p>Across 8,000+ verified reviews</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    var rot = document.getElementById('rot');
    if (rot) {
      var rimgs = [].slice.call(rot.querySelectorAll('.frame .pimg'));
      var rdots = [].slice.call(rot.querySelectorAll('.dots i'));
      var rcapB = rot.querySelector('.cap b');
      var rcapS = rot.querySelector('.cap span');
      var ri = 0, rtimer = null;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function rstep() {
        if (!rimgs.length) return;
        rimgs[ri].classList.remove('on');
        if (rdots[ri]) rdots[ri].classList.remove('on');
        ri = (ri + 1) % rimgs.length;
        rimgs[ri].classList.add('on');
        if (rdots[ri]) rdots[ri].classList.add('on');
        if (rcapB) rcapB.innerHTML = rimgs[ri].getAttribute('data-name');
        if (rcapS) rcapS.textContent = rimgs[ri].getAttribute('data-note');
      }

      if (!reduce && rimgs.length > 0) {
        if ('IntersectionObserver' in window) {
          var rio = new IntersectionObserver(function (es) {
            es.forEach(function (e) {
              if (e.isIntersecting && !rtimer) rtimer = setInterval(rstep, 2900);
              else if (!e.isIntersecting && rtimer) { clearInterval(rtimer); rtimer = null; }
            });
          }, { threshold: 0.25 });
          rio.observe(rot);
        } else {
          rtimer = setInterval(rstep, 2900);
        }
      }
    }
  })();
</script>


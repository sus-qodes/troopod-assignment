{%- comment -%}
  Purelane — Build Your Bundle / Tiers Section
  Pixel-perfect implementation matching prototype screenshot reference.
{%- endcomment -%}

{%- style -%}
  .tiers{display:grid;gap:16px;grid-template-columns:1fr}
  @media(min-width:760px){.tiers{grid-template-columns:repeat(3,1fr)}}
  .tier{padding:26px 24px 28px;display:flex;flex-direction:column;text-align:left;transition:.4s var(--ease);
    border-radius:24px;background:rgba(255,255,255,.45);backdrop-filter:blur(16px);border:1px solid rgba(255,255,255,.8)}
  .tier:hover{transform:translateY(-5px)}
  .tier.best{border:1.5px solid rgba(210,160,50,.7);box-shadow:0 14px 34px rgba(180,130,30,.12)}
  .tier .tag{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;padding:5px 12px;border-radius:999px;margin-bottom:16px;align-self:flex-start;
    background:rgba(230,220,180,.32);border:1px solid rgba(180,160,100,.42);color:#846820}
  
  .tierpix{display:flex;align-items:center;justify-content:center;height:86px;width:100%;margin-bottom:16px;
    padding:8px 12px;border-radius:0;background:rgba(235,238,246,.52);border:1px solid rgba(220,226,236,.6)}
  
  .tier .qty{font-family:'Outfit',sans-serif;font-weight:800;font-size:54px;line-height:.9;color:#1e2530;letter-spacing:-.03em;
    padding:14px 18px;width:100%;border-radius:0;background:rgba(240,244,248,.52);border:1px solid rgba(220,226,236,.6);margin-bottom:16px}
  .tier .qty small{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:#667085;display:block;margin-top:4px}
  
  .tier .price{font-family:'Outfit',sans-serif;font-weight:800;font-size:26px;color:#b8701c;margin:0 0 2px;display:flex;align-items:baseline;gap:8px}
  .tier .price s{font-size:13.5px;color:#667085;font-weight:500;text-decoration:line-through}
  .tier .body-s{font-size:12px;color:#475467;margin-top:2px;margin-bottom:16px}
  
  .tier ul{list-style:none;margin:0 0 22px;display:grid;gap:9px;padding:0;width:100%;text-align:left;flex:1}
  .tier li{display:flex;gap:9px;font-size:13px;color:#344054;align-items:center}
  .tier li svg{width:14px;height:14px;color:#3b7c20;flex:0 0 auto}
  
  .tier .btn{width:100%;justify-content:center;border-radius:999px;padding:13px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;font-size:12px}
  .tier .btn-ghost{background:#ffffff;border:1px solid rgba(210,220,230,.7);color:#101828}
  .tier .btn-primary{background:#004b46;color:#ffffff;border:none}
{%- endstyle -%}

<!-- ================= BUNDLES ================= -->
<section class="sec" id="bundles" data-scene="3" {{ section.shopify_attributes }}>
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker | default: "Build your bundle" }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | default: "One box. Every room." }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.description | default: "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way." }}</p>
      </div>
    </div>

    <div class="tiers">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign tier_prod = block.settings.product -%}

          {%- assign display_price = block.settings.price -%}
          {%- if display_price == blank and tier_prod != blank -%}
            {%- assign display_price = tier_prod.price | money -%}
          {%- endif -%}
          {%- if display_price == blank -%}
            {%- assign display_price = "₹349" -%}
          {%- endif -%}

          {%- assign display_compare = block.settings.compare_at_price -%}
          {%- if display_compare == blank and tier_prod != blank and tier_prod.compare_at_price > tier_prod.price -%}
            {%- assign display_compare = tier_prod.compare_at_price | money -%}
          {%- endif -%}

          {%- assign tier_url = block.settings.button_link -%}
          {%- if tier_url == blank and tier_prod != blank -%}
            {%- assign tier_url = tier_prod.url -%}
          {%- endif -%}

          <article class="glass tier{% if block.settings.is_featured %} best{% endif %} rv" {{ block.shopify_attributes }}>
            {%- if block.settings.tag != blank -%}
              <span class="tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            <div class="tierpix{% if block.settings.is_five %} five{% endif %}" aria-hidden="true">
              {%- if block.settings.is_five -%}

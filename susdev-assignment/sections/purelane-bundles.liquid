          "default": "Starter"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Product Quantity",
          "default": "3"
        },
        {
          "type": "text",
          "id": "qty_unit",
          "label": "Quantity Unit Label",
          "default": "Products"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Display Price Override",
          "default": "₹499"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare Price Override",
          "default": "₹897"
        },
        {
          "type": "text",

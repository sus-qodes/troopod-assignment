          "label": "Per Product Note",
          "default": "Flat ₹166 per product"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet Point 1",
          "default": "Pick any three products"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet Point 2",
          "default": "Covers kitchen and laundry"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet Point 3",
          "default": "Free shipping across India"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Build Your Bundle Tiers",
      "blocks": [
        {
          "type": "tier_card",
          "settings": {
            "tag": "Starter",
            "qty": "2",
            "qty_unit": "Products",
            "price": "₹349",
            "compare_at_price": "₹598",
            "per_product_note": "Flat ₹174 per product",
            "bullet_1": "Pick any two products",
            "bullet_2": "Free shipping across India"
          }
        },
        {
          "type": "tier_card",
          "settings": {
            "is_featured": true,
            "tag": "Most popular",
            "qty": "3",
            "qty_unit": "Products",
            "price": "₹499",
            "compare_at_price": "₹897",
            "per_product_note": "Flat ₹166 per product",
            "bullet_1": "Pick any three products",
            "bullet_2": "Covers kitchen and laundry",
            "bullet_3": "Free shipping across India"
          }
        },
        {
          "type": "tier_card",
          "settings": {
            "is_five": true,
            "tag": "Whole home",
            "qty": "5",
            "qty_unit": "Products",
            "price": "₹799",

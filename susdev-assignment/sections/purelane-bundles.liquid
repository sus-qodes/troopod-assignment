                  <rect x="61" y="20" width="18" height="44" rx="3" fill="#584885"/><rect x="66" y="12" width="8" height="8" rx="1" fill="#584885"/><rect x="68" y="8" width="4" height="4" rx="1" fill="#7868a5"/><rect x="65" y="30" width="10" height="14" fill="#ffffff" opacity="0.8"/>
                  <rect x="107" y="20" width="18" height="44" rx="3" fill="#584885"/><rect x="112" y="12" width="8" height="8" rx="1" fill="#584885"/><rect x="114" y="8" width="4" height="4" rx="1" fill="#7868a5"/><rect x="111" y="30" width="10" height="14" fill="#ffffff" opacity="0.8"/>
                  <rect x="153" y="20" width="18" height="44" rx="3" fill="#584885"/><rect x="158" y="12" width="8" height="8" rx="1" fill="#584885"/><rect x="160" y="8" width="4" height="4" rx="1" fill="#7868a5"/><rect x="157" y="30" width="10" height="14" fill="#ffffff" opacity="0.8"/>
                  <rect x="199" y="20" width="18" height="44" rx="3" fill="#584885"/><rect x="204" y="12" width="8" height="8" rx="1" fill="#584885"/><rect x="206" y="8" width="4" height="4" rx="1" fill="#7868a5"/><rect x="203" y="30" width="10" height="14" fill="#ffffff" opacity="0.8"/>
                </svg>
              {%- elsif block.settings.is_featured -%}
                <svg viewBox="0 0 180 80" fill="none" xmlns="http://www.w3.org/2000/svg" style="height:56px;width:auto">
                  <rect x="30" y="18" width="22" height="48" rx="4" fill="#584885"/><rect x="36" y="10" width="10" height="8" rx="1" fill="#584885"/><rect x="38" y="6" width="6" height="4" rx="1" fill="#7868a5"/><rect x="35" y="28" width="12" height="16" fill="#ffffff" opacity="0.8"/><line x1="38" y1="33" x2="44" y2="33" stroke="#584885" stroke-width="1.5"/><line x1="38" y1="38" x2="44" y2="38" stroke="#584885" stroke-width="1.5"/>
                  <rect x="79" y="18" width="22" height="48" rx="4" fill="#584885"/><rect x="85" y="10" width="10" height="8" rx="1" fill="#584885"/><rect x="87" y="6" width="6" height="4" rx="1" fill="#7868a5"/><rect x="84" y="28" width="12" height="16" fill="#ffffff" opacity="0.8"/><line x1="87" y1="33" x2="93" y2="33" stroke="#584885" stroke-width="1.5"/><line x1="87" y1="38" x2="93" y2="38" stroke="#584885" stroke-width="1.5"/>
                  <rect x="128" y="18" width="22" height="48" rx="4" fill="#584885"/><rect x="134" y="10" width="10" height="8" rx="1" fill="#584885"/><rect x="136" y="6" width="6" height="4" rx="1" fill="#7868a5"/><rect x="133" y="28" width="12" height="16" fill="#ffffff" opacity="0.8"/><line x1="136" y1="33" x2="142" y2="33" stroke="#584885" stroke-width="1.5"/><line x1="136" y1="38" x2="142" y2="38" stroke="#584885" stroke-width="1.5"/>
                </svg>
              {%- else -%}
                <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg" style="height:56px;width:auto">
                  <rect x="35" y="24" width="18" height="42" rx="3" fill="#6b5b95"/><rect x="39" y="16" width="10" height="8" rx="1" fill="#6b5b95"/><rect x="41" y="12" width="6" height="4" rx="1" fill="#8878b0"/><rect x="39" y="32" width="10" height="14" fill="#ffffff" opacity="0.8"/>
                  <rect x="65" y="14" width="22" height="52" rx="4" fill="#584885"/><rect x="71" y="6" width="10" height="8" rx="1" fill="#584885"/><rect x="73" y="2" width="6" height="4" rx="1" fill="#7868a5"/><rect x="70" y="24" width="12" height="18" fill="#ffffff" opacity="0.8"/>
                  <rect x="99" y="28" width="18" height="38" rx="3" fill="#6b5b95"/><rect x="103" y="20" width="10" height="8" rx="1" fill="#6b5b95"/><rect x="105" y="16" width="6" height="4" rx="1" fill="#8878b0"/><rect x="103" y="36" width="10" height="12" fill="#ffffff" opacity="0.8"/>
                </svg>
              {%- endif -%}
            </div>

            <div class="qty">{{ block.settings.qty | default: "3" }}<small>{{ block.settings.qty_unit | default: "Products" }}</small></div>
            
            <div class="price">
              {{ display_price }}
              {%- if display_compare != blank -%}
                <s>{{ display_compare }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.per_product_note != blank -%}
              <p class="body-s">{{ block.settings.per_product_note }}</p>
            {%- endif -%}

            <ul>
              {%- if block.settings.bullet_1 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_1 }}</li>
              {%- endif -%}
              {%- if block.settings.bullet_2 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_2 }}</li>
              {%- endif -%}
              {%- if block.settings.bullet_3 != blank -%}
                <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_3 }}</li>
              {%- endif -%}
            </ul>

            <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ tier_url | default: "#shop" }}">
              {{ block.settings.button_label | default: "Build this box" }}
              {%- if block.settings.is_featured -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {%- endif -%}
            </a>
          </article>
        {%- endfor -%}
      {%- else -%}
        <article class="glass tier rv">
          <span class="tag">Starter</span>
          <div class="tierpix" aria-hidden="true">
            <svg viewBox="0 0 160 80" fill="none" xmlns="http://www.w3.org/2000/svg" style="height:56px;width:auto">
              <rect x="35" y="24" width="18" height="42" rx="3" fill="#6b5b95"/><rect x="39" y="16" width="10" height="8" rx="1" fill="#6b5b95"/><rect x="41" y="12" width="6" height="4" rx="1" fill="#8878b0"/><rect x="39" y="32" width="10" height="14" fill="#ffffff" opacity="0.8"/>
              <rect x="65" y="14" width="22" height="52" rx="4" fill="#584885"/><rect x="71" y="6" width="10" height="8" rx="1" fill="#584885"/><rect x="73" y="2" width="6" height="4" rx="1" fill="#7868a5"/><rect x="70" y="24" width="12" height="18" fill="#ffffff" opacity="0.8"/>
              <rect x="99" y="28" width="18" height="38" rx="3" fill="#6b5b95"/><rect x="103" y="20" width="10" height="8" rx="1" fill="#6b5b95"/><rect x="105" y="16" width="6" height="4" rx="1" fill="#8878b0"/><rect x="103" y="36" width="10" height="12" fill="#ffffff" opacity="0.8"/>
            </svg>
          </div>
          <div class="qty">2<small>Products</small></div>
          <div class="price">₹349 <s>₹598</s></div>
          <p class="body-s">Flat ₹174 per product</p>
          <ul>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Pick any two products</li>
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>Free shipping across India</li>
          </ul>

</div>

<script>
  (function() {
    var scenes = document.getElementById('scenes');
    if (scenes) {
      var scEls = [].slice.call(scenes.querySelectorAll('.scene'));
      function updateScene() {
        var secs = [].slice.call(document.querySelectorAll('[data-scene]'));
        var top = window.scrollY || window.pageYOffset;
        var mid = top + window.innerHeight * 0.45;
        var current = 1;
        secs.forEach(function (sec) {
          var rect = sec.getBoundingClientRect();
          var secTop = rect.top + top;
          if (mid >= secTop) {
            current = parseInt(sec.getAttribute('data-scene') || '1', 10);
          }
        });
        scEls.forEach(function (el, idx) {
          el.classList.toggle('on', idx + 1 === current);
        });
        scenes.setAttribute('data-d', String(current));
      }
      window.addEventListener('scroll', updateScene, { passive: true });
      updateScene();
    }
  })();
</script>
